    "faq": {
      "type": "faq-accordion",
      "blocks": {
        "faq-1": {
          "type": "question",
          "settings": {
            "question": "What is dermocosmetic skincare?",
            "answer": "<p>Dermocosmetic skincare sits between everyday cosmetics and dermatology-informed care, typically formulated with concentrated active ingredients and organised around a specific skin concern.</p>"
          }
        },
        "faq-2": {
          "type": "question",
          "settings": {
            "question": "How do I choose products for my skin concern?",
            "answer": "<p>Start with the concern you want to address, then review each product's stated purpose, suitability and usage instructions. Introduce new actives gradually and monitor tolerance.</p>"
          }
        },
        "faq-3": {
          "type": "question",
          "settings": {
            "question": "Are all C-Aesthetics products suitable for home use?",
            "answer": "<p>No. Products intended only for trained or qualified professionals are clearly labelled and are not sold for unsupervised home application.</p>"
          }
        },
        "faq-4": {
          "type": "question",
          "settings": {
            "question": "What is an exosome skincare product?",
            "answer": "<p>A topical formulation marketed with exosome-derived or extracellular-vesicle-related ingredients. Composition, source and supporting evidence differ between products.</p>"
          }
        },
        "faq-5": {
          "type": "question",
          "settings": {
            "question": "Is microneedling suitable for everyone?",
            "answer": "<p>Suitability depends on individual skin condition, medical history and professional assessment. Professional devices should be used only by qualified practitioners.</p>"
          }
        },
        "faq-6": {
          "type": "question",
          "settings": {
            "question": "Which products can be used after an aesthetic procedure?",
            "answer": "<p>This depends on the specific treatment, current skin condition and your practitioner's instructions. Always follow their guidance.</p>"
          }
        },
        "faq-7": {
          "type": "question",
          "settings": {
            "question": "When should I consult a qualified professional?",
            "answer": "<p>For persistent, severe or diagnosed skin conditions, or before starting a professional-use product or procedure-related routine.</p>"
          }
        }
      },
