          "settings": {
            "heading": "From lab to routine",
            "heading_size": "h0"
          }
        },
        "text": {
          "type": "text",
          "settings": {
            "text": "<p>Every formula starts with a specific skin outcome, moves through dermatologist review, and is tested for tolerability and efficacy before it's approved for release. We publish the purpose of every core ingredient on the product page \u2014 no proprietary mystery blends.</p>"
          }
        }
      },
