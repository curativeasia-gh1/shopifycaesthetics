{%- comment -%}
  Accessible breadcrumb trail + BreadcrumbList JSON-LD.
  Used on product, collection, page and article templates.
{%- endcomment -%}
<nav class="breadcrumbs caption-large" aria-label="{{ 'general.breadcrumbs.label' | t }}">
  <ol class="breadcrumbs__list" role="list">
    <li class="breadcrumbs__item">
      <a href="{{ routes.root_url }}">{{ 'general.breadcrumbs.home' | t }}</a>
    </li>
    {%- if template contains 'product' and product -%}
      {%- if collection.url -%}
        <li class="breadcrumbs__item">
          <a href="{{ collection.url }}">{{ collection.title }}</a>
        </li>
      {%- endif -%}
      <li class="breadcrumbs__item" aria-current="page">{{ product.title }}</li>
    {%- elsif template contains 'collection' and collection -%}
      <li class="breadcrumbs__item" aria-current="page">{{ collection.title }}</li>
    {%- elsif template contains 'article' and article -%}
      {%- if blog -%}
        <li class="breadcrumbs__item">
          <a href="{{ blog.url }}">{{ blog.title }}</a>
        </li>
      {%- endif -%}
      <li class="breadcrumbs__item" aria-current="page">{{ article.title }}</li>
    {%- elsif page -%}
      <li class="breadcrumbs__item" aria-current="page">{{ page.title }}</li>
    {%- endif -%}
  </ol>
</nav>

<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": {{ 'general.breadcrumbs.home' | t | json }},
        "item": {{ shop.url | append: routes.root_url | json }}
      }
      {%- if template contains 'product' and product -%}
        {%- if collection.url -%}
          ,{
            "@type": "ListItem",
            "position": 2,
            "name": {{ collection.title | json }},
            "item": {{ shop.url | append: collection.url | json }}
          },
          {
            "@type": "ListItem",
            "position": 3,
            "name": {{ product.title | json }},
            "item": {{ shop.url | append: product.url | json }}
          }
        {%- else -%}
          ,{
            "@type": "ListItem",
            "position": 2,
            "name": {{ product.title | json }},
            "item": {{ shop.url | append: product.url | json }}
          }
        {%- endif -%}
      {%- elsif template contains 'collection' and collection -%}
        ,{
          "@type": "ListItem",
          "position": 2,
          "name": {{ collection.title | json }},
          "item": {{ shop.url | append: collection.url | json }}
        }
      {%- elsif template contains 'article' and article -%}
        {%- if blog -%}
          ,{
            "@type": "ListItem",
            "position": 2,
            "name": {{ blog.title | json }},
            "item": {{ shop.url | append: blog.url | json }}
          },
          {
            "@type": "ListItem",
            "position": 3,
            "name": {{ article.title | json }},
            "item": {{ shop.url | append: article.url | json }}
          }
        {%- else -%}
          ,{
            "@type": "ListItem",
            "position": 2,
            "name": {{ article.title | json }},
            "item": {{ shop.url | append: article.url | json }}
          }
        {%- endif -%}
      {%- elsif page -%}
        ,{
          "@type": "ListItem",
          "position": 2,
          "name": {{ page.title | json }},
          "item": {{ shop.url | append: page.url | json }}
        }
      {%- endif -%}
    ]
  }
</script>
