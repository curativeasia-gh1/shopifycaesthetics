{{ 'section-advanced-categories.css' | asset_url | stylesheet_tag }}

<div class="advanced-categories color-{{ section.settings.color_scheme }} gradient">
  <div class="advanced-categories__inner page-width">
    {%- if section.settings.heading != blank -%}
      <h2 class="advanced-categories__heading">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}

    <div class="advanced-categories__grid">
      {%- for block in section.blocks -%}
        {%- if block.type == 'category' -%}
          <article class="advanced-categories__card" {{ block.shopify_attributes }}>
            <div class="advanced-categories__media">
              {%- if block.settings.image != blank -%}
                {{
                  block.settings.image
                  | image_url: width: 900
                  | image_tag: loading: 'lazy', sizes: '(min-width: 750px) 33vw, 100vw', widths: '450, 650, 900', alt: block.settings.title
                }}
              {%- else -%}
                {{ 'collection-2' | placeholder_svg_tag: 'placeholder-svg' }}
              {%- endif -%}
            </div>
            <div class="advanced-categories__content">
              <h3 class="advanced-categories__title">{{ block.settings.title | escape }}</h3>
              {%- if block.settings.text != blank -%}
                <p class="advanced-categories__text">{{ block.settings.text }}</p>
              {%- endif -%}
              {%- if block.settings.badge != blank -%}
                <span class="advanced-categories__badge">{{ block.settings.badge | escape }}</span>
              {%- endif -%}
              {%- if block.settings.link != blank -%}
                <a href="{{ block.settings.link }}" class="link advanced-categories__link">
                  {{ block.settings.link_label | default: 'Explore' | escape }}
                </a>
              {%- endif -%}
            </div>
          </article>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Advanced categories",
  "class": "section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-2"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Advanced categories"
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Exosome solutions"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Description",
          "default": "<p>Explore exosome-based topical and professional solutions selected for skin-conditioning and post-procedure protocols.</p>"
        },
        {
          "type": "text",
          "id": "badge",
          "label": "Badge (optional)",
          "info": "E.g. \"Professional and home-care\" or \"Professional use only\""
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "Link label",
          "default": "Explore exosome solutions"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Advanced categories",
      "blocks": [
        {
          "type": "category",
          "settings": {
            "title": "Exosome solutions",
            "text": "<p>Explore exosome-based topical and professional solutions selected for skin-conditioning and post-procedure protocols. Formulations, sources and concentrations vary by product.</p>",
            "link_label": "Explore exosome solutions"
          }
        },
        {
          "type": "category",
          "settings": {
            "title": "Microneedling",
            "text": "<p>Discover professional microneedling products, accessories and supporting skincare for carefully planned treatment protocols.</p>",
            "badge": "Includes professional-only devices",
            "link_label": "Explore microneedling"
          }
        },
        {
          "type": "category",
          "settings": {
            "title": "NAD+",
            "text": "<p>Explore NAD+-focused products positioned around cellular wellness, vitality and healthy-ageing routines.</p>",
            "link_label": "Explore NAD+"
          }
        }
      ]
    }
  ]
}
{% endschema %}
