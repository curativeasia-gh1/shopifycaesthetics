{{ 'section-editorial-article.css' | asset_url | stylesheet_tag }}

<div class="editorial-article color-{{ section.settings.color_scheme }}">
  <div class="editorial-article__inner page-width page-width--narrow">
    {%- if section.settings.eyebrow != blank -%}
      <p class="editorial-article__eyebrow caption-with-letter-spacing">{{ section.settings.eyebrow | escape }}</p>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <h1 class="editorial-article__heading">{{ section.settings.heading | escape }}</h1>
    {%- endif -%}
    {%- if section.settings.intro != blank -%}
      <div class="editorial-article__intro rte">{{ section.settings.intro }}</div>
    {%- endif -%}

    {%- for block in section.blocks -%}
      {%- case block.type -%}

        {%- when 'heading' -%}
          <{{ block.settings.level }} class="editorial-article__section-heading" {{ block.shopify_attributes }}>
            {{ block.settings.text | escape }}
          </{{ block.settings.level }}>

        {%- when 'richtext' -%}
          <div class="editorial-article__text rte" {{ block.shopify_attributes }}>
            {{ block.settings.content }}
          </div>

        {%- when 'columns' -%}
          <div class="editorial-article__columns editorial-article__columns--{{ block.settings.column_count }}" {{ block.shopify_attributes }}>
            {%- if block.settings.col_1_heading != blank or block.settings.col_1_text != blank -%}
              <div class="editorial-article__column">
                {%- if block.settings.col_1_heading != blank -%}<h3>{{ block.settings.col_1_heading | escape }}</h3>{%- endif -%}
                <div class="rte">{{ block.settings.col_1_text }}</div>
              </div>
            {%- endif -%}
            {%- if block.settings.col_2_heading != blank or block.settings.col_2_text != blank -%}
              <div class="editorial-article__column">
                {%- if block.settings.col_2_heading != blank -%}<h3>{{ block.settings.col_2_heading | escape }}</h3>{%- endif -%}
                <div class="rte">{{ block.settings.col_2_text }}</div>
              </div>
            {%- endif -%}
          </div>

        {%- when 'notice' -%}
          <div class="editorial-article__notice rte caption-large" {{ block.shopify_attributes }}>
            {%- if block.settings.label != blank -%}
              <p class="editorial-article__notice-label">{{ block.settings.label | escape }}</p>
            {%- endif -%}
            {{ block.settings.content }}
          </div>

        {%- when 'cta_group' -%}
          <div class="editorial-article__cta-group" {{ block.shopify_attributes }}>
            {%- if block.settings.primary_label != blank -%}
              <a href="{{ block.settings.primary_link | default: '#' }}" class="button">{{ block.settings.primary_label | escape }}</a>
            {%- endif -%}
            {%- if block.settings.secondary_label != blank -%}
              <a href="{{ block.settings.secondary_link | default: '#' }}" class="button button--secondary">{{ block.settings.secondary_label | escape }}</a>
            {%- endif -%}
            {%- if block.settings.tertiary_label != blank -%}
              <a href="{{ block.settings.tertiary_link | default: '#' }}" class="button button--secondary">{{ block.settings.tertiary_label | escape }}</a>
            {%- endif -%}
          </div>

        {%- when 'divider' -%}
          <hr class="editorial-article__divider" {{ block.shopify_attributes }}>

      {%- endcase -%}
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Editorial content",
  "class": "section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Page heading" },
    { "type": "richtext", "id": "intro", "label": "Intro paragraph" }
  ],
  "blocks": [
    {
      "type": "heading",
      "name": "Subheading",
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "Section heading" },
        {
          "type": "select",
          "id": "level",
          "label": "Heading level",
          "options": [
            { "value": "h2", "label": "H2" },
            { "value": "h3", "label": "H3" }
          ],
          "default": "h2"
        }
      ]
    },
    {
      "type": "richtext",
      "name": "Text block",
      "settings": [
        { "type": "richtext", "id": "content", "label": "Content", "default": "<p>Content</p>" }
      ]
    },
    {
      "type": "columns",
      "name": "Two-column block",
      "settings": [
        {
          "type": "select",
          "id": "column_count",
          "label": "Columns",
          "options": [
            { "value": "2", "label": "2" }
          ],
          "default": "2"
        },
        { "type": "text", "id": "col_1_heading", "label": "Column 1 heading" },
        { "type": "richtext", "id": "col_1_text", "label": "Column 1 text" },
        { "type": "text", "id": "col_2_heading", "label": "Column 2 heading" },
        { "type": "richtext", "id": "col_2_text", "label": "Column 2 text" }
      ]
    },
    {
      "type": "notice",
      "name": "Notice / disclaimer",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Important notice" },
        { "type": "richtext", "id": "content", "label": "Content", "default": "<p>Notice text.</p>" }
      ]
    },
    {
      "type": "cta_group",
      "name": "Call-to-action links",
      "settings": [
        { "type": "text", "id": "primary_label", "label": "Primary label" },
        { "type": "url", "id": "primary_link", "label": "Primary link" },
        { "type": "text", "id": "secondary_label", "label": "Secondary label" },
        { "type": "url", "id": "secondary_link", "label": "Secondary link" },
        { "type": "text", "id": "tertiary_label", "label": "Tertiary label" },
        { "type": "url", "id": "tertiary_link", "label": "Tertiary link" }
      ]
    },
    {
      "type": "divider",
      "name": "Divider",
      "settings": []
    }
  ],
  "presets": [
    { "name": "Editorial content" }
  ]
}
{% endschema %}
